// TUM Nyumba — Prisma Schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  PARTNER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  VERIFIED
  SUSPENDED
  REJECTED
}

enum PropertyCategory {
  SINGLE_ROOM
  BEDSITTER
  STUDIO
  ONE_BED
  TWO_BED
  HOSTEL
  SHARED_ROOM
  BNB
}

enum AvailabilityStatus {
  AVAILABLE
  TAKEN
  PAUSED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LeadStatus {
  PENDING
  CONTACTED
  BOOKED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum FundingType {
  HELB
  SELF
  PARENT
  WORKING
}

// ─── BOOKING PAYMENT ENUMS ────────────────────────────────────────────────────

enum PaymentRouting {
  DIRECT
  SPLIT
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum BookingStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BookingPaymentStatus {
  QUEUED
  PUSHED
  CONFIRMED
  FAILED
  TIMEOUT
}

enum PayoutStatus {
  PENDING
  QUEUED
  PAID
  FAILED
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  password      String
  role          Role      @default(STUDENT)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile     StudentProfile?
  partnerProfile     PartnerProfile?
  leads              Lead[]                    @relation("StudentLeads")
  savedProperties    SavedProperty[]
  sentMessages       Message[]                 @relation("SentMessages")
  conversations      ConversationParticipant[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  bookings           Booking[]

  @@map("users")
}

model StudentProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  course      String?
  yearOfStudy Int?
  fundingType FundingType @default(SELF)
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model PartnerProfile {
  id                String        @id @default(cuid())
  userId            String        @unique
  companyName       String
  licenseNumber     String?
  businessPermitUrl String?       @db.Text
  status            PartnerStatus @default(PENDING)
  totalLeadsPaid    Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // ── Payment routing ────────────────────────────────────────────────────────
  // All nullable — existing partner rows are unaffected before admin configures them
  paymentRouting      PaymentRouting  @default(SPLIT)
  // DIRECT mode only — AES-256-GCM encrypted blobs, never stored as plaintext
  mpesaShortcode      String?         @db.VarChar(20)
  mpesaPasskey        Bytes?          @db.VarBinary(512)
  mpesaConsumerKey    Bytes?          @db.VarBinary(512)
  mpesaConsumerSecret Bytes?          @db.VarBinary(512)
  // SPLIT mode only
  payoutPhone         String?         @db.VarChar(15)
  commissionType      CommissionType  @default(PERCENTAGE)
  commissionValue     Decimal         @default(10.00) @db.Decimal(10, 2)

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties      Property[]
  invoices        Invoice[]
  bookings        Booking[]
  bookingPayments BookingPayment[]

  @@map("partner_profiles")
}

model Property {
  id                 String             @id @default(cuid())
  partnerId          String
  title              String
  category           PropertyCategory
  county             String
  subcounty          String
  area               String
  latitude           Float?
  longitude          Float?
  mapUrl             String?            @db.Text
  rent               Int
  deposit            Int
  contactPerson      String?
  contactPhone       String?
  description        String             @db.Text
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  verificationStatus VerificationStatus @default(PENDING)
  autoRelist         Boolean            @default(false)
  views              Int                @default(0)
  featured           Boolean            @default(false)
  leadFee            Int                @default(0)
  totalSpaces        Int                @default(1)
  availableSpaces    Int                @default(1)

  // Amenities
  wifi        Boolean @default(false)
  water       Boolean @default(false)
  electricity Boolean @default(false)
  parking     Boolean @default(false)
  security    Boolean @default(false)

  images    PropertyImage[]
  leads     Lead[]
  savedBy   SavedProperty[]

  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Indexes for public listing search ──────────────────────────────────────
  // Composite index covering the two hard WHERE filters on every public query
  @@index([verificationStatus, availabilityStatus, featured])
  // Search filter columns — individual indexes used by the query planner
  // when only a subset of filters are active
  @@index([area])
  @@index([category])
  @@index([rent])
  @@index([partnerId])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String   @db.Text
  publicId   String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // propertyId — queried on every property detail page load
  @@index([propertyId])
  @@map("property_images")
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  // userId — queried every time a student opens their saved listings page
  @@index([userId])
  @@map("saved_properties")
}

model Lead {
  id         String     @id @default(cuid())
  propertyId String
  studentId  String
  status     LeadStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  student  User     @relation("StudentLeads", fields: [studentId], references: [id], onDelete: Cascade)
  leadFee  LeadFee?

  @@unique([propertyId, studentId])
  // studentId — queried on every student dashboard/leads page
  @@index([studentId])
  // propertyId — queried by partner when viewing leads per property
  @@index([propertyId])
  @@map("leads")
}

model LeadFee {
  id        String   @id @default(cuid())
  leadId    String   @unique
  partnerId String
  amount    Int      @default(50)
  paid      Boolean  @default(false)
  invoiceId String?

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  // partnerId — queried during invoice generation to sum fees per partner
  @@index([partnerId])
  @@map("lead_fees")
}

model Invoice {
  id          String        @id @default(cuid())
  partnerId   String
  periodStart DateTime
  periodEnd   DateTime
  totalLeads  Int           @default(0)
  totalAmount Int           @default(0)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime

  partner  PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leadFees LeadFee[]
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // partnerId — queried on every partner billing/invoice page
  @@index([partnerId])
  @@map("invoices")
}

model Payment {
  id             String   @id @default(cuid())
  invoiceId      String   @unique
  amount         Int
  method         String   @default("MPESA")
  transactionRef String?
  paidAt         DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  // Fetched per-user on every page load — must be indexed
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  // userId — chat list query finds all conversations for current user
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  // Fetched per-conversation thread, ordered by time — composite index is essential
  @@index([conversationId, createdAt(sort: Asc)])
  @@map("messages")
}

// ─── BOOKING & PAYMENT MODELS ────────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  partnerId   String        // PartnerProfile.id
  studentId   String        // User.id — phone is always read from User.phone
  amountDue   Decimal       @db.Decimal(10, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  partner  PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  student  User           @relation(fields: [studentId], references: [id])
  payments BookingPayment[]

  @@index([partnerId])
  @@index([studentId])
  @@map("bookings")
}

model BookingPayment {
  id                   String               @id @default(cuid())
  bookingId            String
  partnerId            String
  amount               Decimal              @db.Decimal(10, 2)
  status               BookingPaymentStatus @default(QUEUED)
  routingMode          PaymentRouting       // snapshot of partner mode at time of payment
  checkoutRequestId    String?              @unique @db.VarChar(50)
  mpesaReceiptNumber   String?              @db.VarChar(30)

  // SPLIT mode only — null for DIRECT
  commissionAmount     Decimal?             @db.Decimal(10, 2)
  partnerPayoutAmount  Decimal?             @db.Decimal(10, 2)
  payoutStatus         PayoutStatus?
  payoutConversationId String?              @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id])
  partner PartnerProfile @relation(fields: [partnerId], references: [id])

  @@index([bookingId])
  @@index([partnerId])
  @@index([checkoutRequestId])
  @@index([payoutConversationId])
  @@map("booking_payments")
}

// ─── EMAIL VERIFICATION & PASSWORD RESET ──────────────────────────────────────

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

# ─── Database (TiDB Cloud / MySQL) ───────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/tum_nyumba?sslaccept=strict"

# ─── NextAuth / Auth.js ───────────────────────────────────────────────────────
# Secret keys for signing tokens. Generate with: `openssl rand -hex 32`
NEXTAUTH_SECRET="your_nextauth_secret_here"
AUTH_SECRET="your_auth_secret_here"
AUTH_TRUST_HOST=true
# Set NEXTAUTH_URL to your production domain on Vercel/live host (e.g., https://campuskey.co.ke)
NEXTAUTH_URL="https://campuskey.co.ke"

# ─── Cloudinary (property image uploads) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"

# ─── Pusher (real-time chat) ──────────────────────────────────────────────────
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ─── Upstash Redis (Idempotency Locks & Token Cache) ──────────────────────────
# Sign up at https://upstash.com (Free Tier)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# ─── Upstash QStash (Serverless Worker & Cron Delivery) ───────────────────────
# Sign up at https://upstash.com (Free Tier: 500 requests/day)
QSTASH_TOKEN="your_qstash_token"
QSTASH_CURRENT_SIGNING_KEY="your_qstash_current_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key"

# ─── M-Pesa Daraja API (Platform SPLIT Collection & Reconciliation) ───────────
MPESA_CONSUMER_KEY="your_platform_consumer_key"
MPESA_CONSUMER_SECRET="your_platform_consumer_secret"
MPESA_PAYBILL="174379"
MPESA_PASSKEY="your_platform_passkey"
MPESA_CALLBACK_BASE_URL="https://campuskey.co.ke"
MPESA_ENV="sandbox" # or "production"

# ─── M-Pesa B2C (Automated Partner Payouts — SPLIT mode) ───────────────────────
MPESA_B2C_INITIATOR_NAME="your_initiator_name"
MPESA_B2C_SECURITY_CREDENTIAL="your_encrypted_security_credential"
MPESA_B2C_SHORTCODE="600000"

# ─── Partner Credential Encryption (DIRECT mode) ─────────────────────────────
# Master key for AES-256-GCM encryption of partner credentials stored in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY="your_64_character_hex_key_here"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# Then verify campuskey.co.ke as a sending domain in the Resend dashboard.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used to build absolute links inside emails (verify, reset-password, etc.)
NEXT_PUBLIC_APP_URL="https://campuskey.co.ke"
